---
// Texas hold'em, heads-up against the dealer: ante, see the flop, then call
// (twice the ante) or fold. Best five cards out of seven wins even money.
import ChipRow from "./ChipRow.astro";
import type { Lang } from "../../games/registry";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        dealer: "Crupier",
        board: "Mesa",
        you: "Tú",
        ante: "Apuesta inicial",
        deal: "Repartir",
        call: "Igualar",
        fold: "Retirarse",
        decide: "Flop en la mesa: ¿igualas o te retiras?",
        win: "Ganas con",
        lose: "Gana el crupier con",
        push: "Empate — recuperas la apuesta",
        folded: "Te retiras",
        noChips: "No tienes fichas suficientes",
        hands: {
          high: "Carta alta",
          pair: "Pareja",
          twoPair: "Doble pareja",
          three: "Trío",
          straight: "Escalera",
          flush: "Color",
          fullHouse: "Full",
          four: "Póker",
          straightFlush: "Escalera de color",
          royal: "Escalera real",
        },
      }
    : {
        dealer: "Dealer",
        board: "Board",
        you: "You",
        ante: "Ante",
        deal: "Deal",
        call: "Call",
        fold: "Fold",
        decide: "Flop is down: call or fold?",
        win: "You win with",
        lose: "Dealer wins with",
        push: "Tie — bet returned",
        folded: "You fold",
        noChips: "Not enough chips",
        hands: {
          high: "High card",
          pair: "Pair",
          twoPair: "Two pair",
          three: "Three of a kind",
          straight: "Straight",
          flush: "Flush",
          fullHouse: "Full house",
          four: "Four of a kind",
          straightFlush: "Straight flush",
          royal: "Royal flush",
        },
      };
---

<div class="game-table hd" data-game="poker" data-t={JSON.stringify(t)}>
  <p class="hand-label">{t.dealer} <b data-dealer-hand></b></p>
  <div class="hand" data-dealer></div>

  <p class="hand-label">{t.board}</p>
  <div class="hand hd-board" data-board></div>

  <p class="result" data-result aria-live="polite"></p>

  <div class="hand" data-player></div>
  <p class="hand-label">{t.you} <b data-player-hand></b></p>

  <div data-betting>
    <ChipRow label={t.ante} />
    <div class="game-actions">
      <button type="button" class="game-btn main" data-deal>{t.deal}</button>
    </div>
  </div>
  <div class="game-actions" data-playing hidden>
    <button type="button" class="game-btn main" data-call>{t.call}</button>
    <button type="button" class="game-btn" data-fold>{t.fold}</button>
  </div>
</div>

<style is:global>
/* Five cards across, even on a 360px phone. */
.hd .hd-board { flex-wrap: nowrap; gap: clamp(0.25rem, 1.5vw, 0.5rem); }
.hd-board .pcard { flex: 1 1 0; min-width: 0; max-width: 4.2rem; height: auto; aspect-ratio: 7 / 10; }
/* Showdown: the winning five stand out, the rest step back. */
.hd .pcard { transition: opacity 0.3s ease, transform 0.4s var(--spring), box-shadow 0.3s ease; }
.hd.showdown .pcard:not(.best) { opacity: 0.45; }
.hd .pcard.best { transform: translateY(-6px); box-shadow: 0 0 0 3px var(--amber), 0 0 22px -2px var(--amber); }
</style>

<script>
  import { bestHand, cardLabel, compareScores, newDeck, type Card } from "../../games/logic";
  import { addChips, burst, fmt, getChips, initBet, reducedMotion, say, setRound, showCards, sleep } from "../../games/ui";

  function init(root: HTMLElement) {
    const t = JSON.parse(root.dataset.t!);
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const dealerEl = $("[data-dealer]");
    const boardEl = $("[data-board]");
    const playerEl = $("[data-player]");
    const result = $("[data-result]");
    const callBtn = $("[data-call]");
    const bet = initBet(root);

    let player: Card[] = [];
    let dealer: Card[] = [];
    let board: Card[] = [];
    let ante = 0;
    let busy = false; // board and dealer are being revealed: ignore clicks

    // Calling costs twice the ante, or whatever is left (all-in).
    const callStake = () => Math.min(ante * 2, getChips());

    /** Shows the first `shown` board cards, and the dealer's hand if `open`. */
    function render(shown: number, open: boolean) {
      const seen = board.slice(0, shown);
      showCards(playerEl, player);
      showCards(dealerEl, dealer, open ? [] : [0, 1]);
      showCards(boardEl, board, [0, 1, 2, 3, 4].filter((i) => i >= shown));
      $("[data-player-hand]").textContent = t.hands[bestHand([...player, ...seen]).name];
      $("[data-dealer-hand]").textContent = open ? t.hands[bestHand([...dealer, ...seen]).name] : "";
    }

    function setPlaying(playing: boolean) {
      setRound(root, playing);
      $("[data-betting]").hidden = playing;
      $("[data-playing]").hidden = !playing;
      if (playing) callBtn.textContent = `${t.call} ${fmt(callStake())}`;
    }

    /** Lights up the cards that make the winning hand. */
    function mark(cards: Card[]) {
      const labels = new Set(cards.map(cardLabel));
      root.classList.add("showdown");
      root.querySelectorAll<HTMLElement>(".pcard").forEach((el) => el.classList.toggle("best", labels.has(el.dataset.c!)));
    }

    $("[data-deal]").addEventListener("click", () => {
      ante = bet();
      if (ante > getChips()) return say(result, t.noChips, "lose");
      addChips(-ante);
      const deck = newDeck();
      player = deck.splice(0, 2);
      dealer = deck.splice(0, 2);
      board = deck.splice(0, 5);
      root.classList.remove("showdown");
      for (const el of [dealerEl, boardEl, playerEl]) el.replaceChildren();
      render(3, false);
      say(result, t.decide);
      setPlaying(true);
    });

    callBtn.addEventListener("click", async () => {
      if (busy) return;
      busy = true;
      const staked = ante + callStake();
      addChips(ante - staked);
      const pause = reducedMotion() ? 0 : 600;
      say(result, "");
      // Turn, river, then the dealer's cards.
      for (const [shown, open] of [[4, false], [5, false], [5, true]] as const) {
        render(shown, open);
        await sleep(pause);
        if (!root.isConnected) return; // navigated away mid-hand
      }

      const mine = bestHand([...player, ...board]);
      const theirs = bestHand([...dealer, ...board]);
      const diff = compareScores(mine.score, theirs.score);
      if (diff > 0) {
        addChips(staked * 2);
        mark(mine.cards);
        say(result, `${t.win} ${t.hands[mine.name]} +${fmt(staked)}`, "win");
        burst(playerEl);
      } else if (diff === 0) {
        addChips(staked);
        mark([...mine.cards, ...theirs.cards]);
        say(result, t.push);
      } else {
        mark(theirs.cards);
        say(result, `${t.lose} ${t.hands[theirs.name]} −${fmt(staked)}`, "lose");
      }
      busy = false;
      setPlaying(false);
    });

    $("[data-fold]").addEventListener("click", () => {
      if (busy) return;
      render(5, true); // show what you folded into
      say(result, `${t.folded} −${fmt(ante)}`, "lose");
      setPlaying(false);
    });
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('[data-game="poker"]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      init(root);
    });
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
