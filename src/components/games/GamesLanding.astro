---
// The /games/ hub: one card per game in the registry.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localize } from "../../i18n/site";
import { games, type Lang } from "../../games/registry";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        title: "Juegos — Burbujas, Blackjack, Póker y Ruleta gratis | Yongchivo",
        description:
          "Juegos rápidos para el navegador: explota burbujas, blackjack, vídeo póker y ruleta con fichas ficticias. Gratis, sin registro y sin dinero real.",
        h1: "Juegos",
        intro: "Partidas rápidas en el navegador. Gratis, sin registro y sin dinero real.",
        play: "Jugar",
      }
    : {
        title: "Games — Free Bubble Pop, Blackjack, Poker & Roulette | Yongchivo",
        description:
          "Quick browser games: bubble pop, blackjack, video poker and roulette with play-money chips. Free, no sign-up and no real money.",
        h1: "Games",
        intro: "Quick games in your browser. Free, no sign-up and no real money.",
        play: "Play",
      };
---

<BaseLayout title={t.title} description={t.description} lang={lang} sideBarActiveItemID="games" alternates={{ en: "/games/", es: "/es/games/" }}>
  <div class="games">
    <h1 class="games-title">{t.h1.toUpperCase()}</h1>
    <p class="games-intro">{t.intro}</p>
    <ul class="games-grid">
      {
        games.map((game, i) => (
          <li>
            <a href={localize(`/games/${game.id}/`, lang)} class={`game-card tone-${game.tone}`} style={`--i:${i}`}>
              <span class="game-orb">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={game.icon} />
              </span>
              <span class="game-name">{game.copy[lang].name}</span>
              <span class="game-desc">{game.copy[lang].desc}</span>
              <span class="game-play">{t.play} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
.games {
  --surface: #131120;
  --surface-2: #1c1a2e;
  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tone-cyan { --tone: #22d3ee; }
.tone-magenta { --tone: #d946ef; }
.tone-purple { --tone: #a855f7; }
.tone-amber { --tone: #fbbf24; }

.games-title {
  text-align: center;
  font-weight: 700;
  font-size: clamp(1.6rem, 7.5vw, 3rem);
  letter-spacing: 0.18em;
  margin: 0 -0.18em 0 0;
  background: linear-gradient(to right, #d946ef, #a855f7, #22d3ee);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.games-intro { text-align: center; opacity: 0.7; margin: 0.75rem auto 2.5rem; max-width: 32rem; }

.games-grid { display: grid; gap: 1rem; list-style: none; padding: 0; margin: 0; }
@media (min-width: 640px) { .games-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

.game-card {
  display: grid;
  justify-items: center;
  gap: 0.45rem;
  height: 100%;
  padding: 1.75rem 1.25rem 1.4rem;
  text-align: center;
  border-radius: 1.25rem;
  background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--tone) 16%, transparent), transparent 60%), var(--surface);
  border: 1px solid var(--surface-2);
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.4s var(--spring);
}
.game-card:hover, .game-card:focus-visible { border-color: var(--tone); box-shadow: 0 0 30px -8px var(--tone); }
.game-card:focus-visible { outline: 2px solid var(--tone); outline-offset: 3px; }
.game-orb {
  width: 4.5rem;
  aspect-ratio: 1;
  border-radius: 9999px;
  display: grid;
  place-items: center;
  color: var(--tone);
  background: radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 32%), var(--surface);
  border: 1px solid rgba(232, 230, 242, 0.14);
  box-shadow: inset 0 -10px 20px rgba(0, 0, 0, 0.4), 0 0 26px -6px var(--tone);
  transition: transform 0.5s var(--spring);
}
.game-orb svg { width: 45%; height: 45%; }
.game-name { font-size: 1.2rem; font-weight: 700; }
.game-desc { font-size: 0.875rem; opacity: 0.7; line-height: 1.4; }
.game-play { margin-top: 0.4rem; font-weight: 700; font-size: 0.9rem; color: var(--tone); }

@media (prefers-reduced-motion: no-preference) {
  .game-card:hover { transform: translateY(-4px); }
  .game-card:hover .game-orb { transform: scale(1.12) rotate(-6deg); }
  .game-orb { animation: game-float 5s ease-in-out infinite; animation-delay: calc(var(--i) * -1.3s); }
}
@keyframes game-float {
  50% { translate: 0 -5px; }
}
</style>
