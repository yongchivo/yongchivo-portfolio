---
// The games section's backdrop: a night landscape in the brand colours —
// stars, a low sun, three ridges and their reflection in a lake. Drawn here
// as SVG, so it is original artwork with nothing to license. Decorative: it
// fills its positioned parent and sits behind the content.

// Stars from a small fixed-seed generator, so every build draws the same sky.
let seed = 7;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 70 }, () => ({
  x: (rand() * 800).toFixed(1),
  y: (rand() * 210).toFixed(1),
  r: (0.4 + rand() * 1.1).toFixed(2),
  o: (0.35 + rand() * 0.65).toFixed(2),
}));
// Unique per instance: two scenes on one page must not share gradient ids.
const id = `scene-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="games-scene" viewBox="0 0 800 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b0a14"></stop>
      <stop offset="0.45" stop-color="#2a1650"></stop>
      <stop offset="0.72" stop-color="#8a2f9e"></stop>
      <stop offset="1" stop-color="#f08a5d"></stop>
    </linearGradient>
    <linearGradient id={`${id}-sun`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fde68a"></stop>
      <stop offset="0.5" stop-color="#fbbf24"></stop>
      <stop offset="1" stop-color="#d946ef"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glow`}>
      <stop offset="0" stop-color="#fbbf24" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#fbbf24" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`${id}-lake`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5b2a86"></stop>
      <stop offset="1" stop-color="#0b0a14"></stop>
    </linearGradient>
  </defs>

  <rect width="800" height="320" fill={`url(#${id}-sky)`}></rect>
  {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#f4f2fb" opacity={s.o} />)}

  <circle cx="560" cy="262" r="150" fill={`url(#${id}-glow)`}></circle>
  <circle cx="560" cy="262" r="62" fill={`url(#${id}-sun)`}></circle>

  {/* Three ridges, far to near. */}
  <path d="M0 300 L70 236 L130 272 L215 196 L300 262 L372 214 L450 276 L540 222 L640 280 L720 232 L800 286 V330 H0Z" fill="#5a2d82"></path>
  <path d="M0 316 L90 268 L170 302 L260 244 L345 300 L430 258 L520 306 L610 262 L700 304 L800 264 V330 H0Z" fill="#3a1d5c"></path>
  <path d="M0 322 L60 300 L150 318 L240 286 L330 320 L420 294 L500 322 L600 298 L690 320 L800 300 V332 H0Z" fill="#1c1030"></path>

  {/* The lake, with the sun's path of light across it. */}
  <rect y="320" width="800" height="130" fill={`url(#${id}-lake)`}></rect>
  <g fill="#fbbf24" opacity="0.5">
    <rect x="520" y="330" width="80" height="3" rx="1.5"></rect>
    <rect x="530" y="342" width="60" height="3" rx="1.5"></rect>
    <rect x="512" y="356" width="96" height="3" rx="1.5" opacity="0.7"></rect>
    <rect x="538" y="372" width="44" height="3" rx="1.5" opacity="0.6"></rect>
    <rect x="524" y="392" width="72" height="3" rx="1.5" opacity="0.4"></rect>
    <rect x="544" y="414" width="32" height="3" rx="1.5" opacity="0.3"></rect>
  </g>
</svg>

<style>
  .games-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    pointer-events: none;
  }
</style>
