---
import { ui } from "../i18n/site";
// brandOnly: the home page shows the brand without my name.
const { lang = "en", brandOnly = false } = Astro.props;
const today = new Date();
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} {brandOnly ? "Yongchivo" : "John Akhis Moreno (Yongchivo)"}
  </div>
  <div class="inline opacity-75">
    {ui[lang].builtWith} <a href="https://github.com/manuelernestog/astrofy" target="_blank" class="font-bold">Astrofy</a>
  </div>
</footer>
<style></style>
