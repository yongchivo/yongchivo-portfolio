---
import { ui } from "../i18n/site";
const { lang = "en" } = Astro.props;
const today = new Date();
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} John Akhis Moreno (Yongchivo)
  </div>
  <div class="inline opacity-75">
    {ui[lang].builtWith} <a href="https://github.com/manuelernestog/astrofy" target="_blank" class="font-bold">Astrofy</a>
  </div>
</footer>
<style></style>
