---
import type { Conversion, Lang } from "../convert/registry";
import { strings } from "../convert/i18n";

interface Props {
  conversion: Conversion;
  lang: Lang;
}

const { conversion, lang } = Astro.props;
const t = strings[lang];
const isImage = conversion.kind === "image";
const isData = conversion.kind === "data";
const isPdf = conversion.kind === "pdf" || conversion.kind === "operation";
const isMedia = conversion.kind === "audio" || conversion.kind === "video";

// Media widget config.
const isVideoInput = conversion.sourceMimes.some((m) => m.startsWith("video/"));
const isGif = conversion.targetExt === "gif";
const mediaDropLabel = isVideoInput ? t.mediaDropVideo : t.mediaDropAudio;
const placeholder =
  lang === "es"
    ? `Pega tu ${conversion.from} aquí…`
    : `Paste your ${conversion.from} here…`;

// PDF widget config, derived from the registry entry.
const mode =
  conversion.kind === "operation" ? conversion.op! : conversion.pdf?.direction;
const multi = conversion.multi === true;
const runLabel: Record<string, string> = {
  "images-to-pdf": t.runCreatePdf,
  "pdf-to-images": t.runConvert,
  merge: t.runMerge,
  split: t.runSplit,
  rotate: t.runRotate,
  compress: t.runCompress,
};
const pdfDropLabel = mode === "images-to-pdf" ? t.pdfDropImages : t.pdfDropPdf;
const showQuality =
  mode === "compress" ||
  (mode === "pdf-to-images" && conversion.pdf?.imageFormat === "image/jpeg");
const qualityDefault = mode === "compress" ? 60 : 92;
---

<div
  data-converter
  data-conv-id={conversion.id}
  data-lang={lang}
  data-kind={conversion.kind}
  class="not-prose"
>
  {
    isImage && (
      <>
        {/* Dropzone (label wraps the hidden input so the whole area is clickable) */}
        <label
          data-cv-drop
          class="flex flex-col items-center justify-center text-center gap-2 rounded-xl border-2 border-dashed border-base-300 bg-base-100 px-6 py-10 cursor-pointer transition hover:border-primary"
        >
          <input data-cv-input type="file" multiple accept={conversion.accept} class="hidden" />
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
          </svg>
          <div class="text-lg font-semibold">{t.dropTitle}</div>
          <div class="text-sm opacity-70">{t.dropHint}</div>
          <span class="btn btn-primary btn-sm mt-2">{t.browse}</span>
          <div class="mt-3 badge badge-accent badge-outline gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 0h10.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5Z" />
            </svg>
            {t.noUploads}
          </div>
        </label>

        {conversion.lossy && (
          <div class="flex items-center gap-3 mt-4">
            <label class="text-sm opacity-80" for={`q-${conversion.id}`}>
              {t.quality}
            </label>
            <input data-cv-quality id={`q-${conversion.id}`} type="range" min="40" max="100" value="92" class="range range-primary range-xs grow max-w-xs" />
            <span data-cv-quality-value class="text-sm tabular-nums w-12 text-right">92%</span>
          </div>
        )}

        <div data-cv-actions class="hidden flex-wrap items-center gap-2 mt-5">
          <button data-cv-download-all class="btn btn-primary btn-sm" disabled>
            {t.downloadAll}
          </button>
          <button data-cv-clear class="btn btn-ghost btn-sm">{t.clear}</button>
        </div>

        <ul data-cv-list class="flex flex-col gap-2 mt-4" />
      </>
    )
  }

  {
    isData && (
      <>
        <div class="grid gap-4 md:grid-cols-2 items-start">
          {/* Input column */}
          <div class="flex flex-col">
            <div class="mb-2 text-sm font-semibold opacity-80">
              {t.dataInputLabel} · <span class="text-accent">{conversion.from}</span>
            </div>
            <label
              data-cv-drop
              class="flex items-center justify-center gap-2 text-center rounded-lg border-2 border-dashed border-base-300 bg-base-100 px-4 py-3 cursor-pointer transition hover:border-primary text-sm"
            >
              <input data-cv-input type="file" accept={conversion.accept} class="hidden" />
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
              </svg>
              <span class="opacity-80">{t.dataDrop}</span>
            </label>
            <textarea
              data-cv-text
              spellcheck="false"
              placeholder={placeholder}
              class="textarea textarea-bordered font-mono text-xs leading-relaxed mt-2 w-full min-h-[240px] whitespace-pre"
            />
          </div>

          {/* Output column */}
          <div class="flex flex-col">
            <div class="mb-2 flex items-center justify-between gap-2">
              <span class="text-sm font-semibold opacity-80">
                {t.dataOutputLabel} · <span class="text-primary">{conversion.to}</span>
              </span>
              <div class="flex items-center gap-1">
                <button data-cv-copy class="btn btn-ghost btn-xs" disabled>{t.copy}</button>
                <a data-cv-download class="btn btn-primary btn-xs pointer-events-none opacity-40" download>
                  {t.download}
                </a>
              </div>
            </div>
            <div data-cv-error class="hidden alert alert-error rounded-lg text-xs py-2 mb-2" />
            <pre class="rounded-lg border border-base-300 bg-base-200 p-3 overflow-auto min-h-[240px] max-h-[460px] text-xs"><code data-cv-output class="font-mono whitespace-pre opacity-50">{t.emptyOutput}</code></pre>
          </div>
        </div>

        <div class="mt-4 badge badge-accent badge-outline gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 0h10.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5Z" />
          </svg>
          {t.noUploads}
        </div>
      </>
    )
  }

  {
    isPdf && (
      <div data-cv-mode={mode} data-cv-multi={multi ? "1" : "0"}>
        {/* Dropzone */}
        <label
          data-cv-drop
          class="flex flex-col items-center justify-center text-center gap-2 rounded-xl border-2 border-dashed border-base-300 bg-base-100 px-6 py-8 cursor-pointer transition hover:border-primary"
        >
          <input data-cv-input type="file" multiple={multi} accept={conversion.accept} class="hidden" />
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
          </svg>
          <div class="text-base font-semibold">{pdfDropLabel}</div>
          <span class="btn btn-primary btn-sm mt-1">{t.browse}</span>
          <div class="mt-2 badge badge-accent badge-outline gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 0h10.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5Z" />
            </svg>
            {t.noUploads}
          </div>
        </label>

        {/* Selected files (reorderable for multi-file tools) */}
        <ul data-cv-files class="flex flex-col gap-2 mt-4" />

        {/* Tool-specific options */}
        <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-3">
          {mode === "images-to-pdf" && (
            <label class="flex flex-col gap-1 text-sm">
              <span class="opacity-80">{t.pageSizeLabel}</span>
              <select data-cv-pagesize class="select select-bordered select-sm">
                <option value="fit">{t.pageSizeFit}</option>
                <option value="a4">A4</option>
                <option value="letter">Letter</option>
              </select>
            </label>
          )}

          {mode === "split" && (
            <label class="flex flex-col gap-1 text-sm grow max-w-xs">
              <span class="opacity-80">{t.splitLabel}</span>
              <input data-cv-ranges type="text" placeholder={t.splitPlaceholder} class="input input-bordered input-sm font-mono" />
            </label>
          )}

          {mode === "rotate" && (
            <>
              <label class="flex flex-col gap-1 text-sm">
                <span class="opacity-80">{t.rotationLabel}</span>
                <select data-cv-angle class="select select-bordered select-sm">
                  <option value="90">90°</option>
                  <option value="180">180°</option>
                  <option value="270">270°</option>
                </select>
              </label>
              <label class="flex flex-col gap-1 text-sm grow max-w-xs">
                <span class="opacity-80">{t.rotatePagesLabel}</span>
                <input data-cv-pages type="text" placeholder={t.rotatePagesPlaceholder} class="input input-bordered input-sm font-mono" />
              </label>
            </>
          )}

          {showQuality && (
            <div class="flex flex-col gap-1 text-sm">
              <span class="opacity-80">
                {t.quality}
                {mode === "compress" && <span class="opacity-60"> · {t.compressQualityHint}</span>}
              </span>
              <div class="flex items-center gap-3">
                <input data-cv-quality type="range" min="30" max="100" value={qualityDefault} class="range range-primary range-xs w-40" />
                <span data-cv-quality-value class="tabular-nums w-12 text-right">{qualityDefault}%</span>
              </div>
            </div>
          )}
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <button data-cv-run class="btn btn-primary btn-sm">{mode ? runLabel[mode] : ""}</button>
          <button data-cv-clear class="btn btn-ghost btn-sm">{t.clear}</button>
        </div>

        <div data-cv-error class="hidden alert alert-error rounded-lg text-xs py-2 mt-4" />

        <ul data-cv-results class="flex flex-col gap-2 mt-4" />
      </div>
    )
  }

  {
    isMedia && (
      <div data-cv-media>
        {/* Dropzone (single file) */}
        <label
          data-cv-drop
          class="flex flex-col items-center justify-center text-center gap-2 rounded-xl border-2 border-dashed border-base-300 bg-base-100 px-6 py-8 cursor-pointer transition hover:border-primary"
        >
          <input data-cv-input type="file" accept={conversion.accept} class="hidden" />
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
          </svg>
          <div class="text-base font-semibold">{mediaDropLabel}</div>
          <span class="btn btn-primary btn-sm mt-1">{t.browse}</span>
          <div class="mt-2 badge badge-accent badge-outline gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 0h10.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5Z" />
            </svg>
            {t.noUploads}
          </div>
        </label>

        {/* Selected file */}
        <ul data-cv-files class="flex flex-col gap-2 mt-4" />

        {/* GIF options */}
        {isGif && (
          <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-3">
            <label class="flex flex-col gap-1 text-sm">
              <span class="opacity-80">{t.gifFpsLabel}</span>
              <input data-cv-fps type="number" min="1" max="30" value="12" class="input input-bordered input-sm w-24" />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="opacity-80">{t.gifWidthLabel}</span>
              <input data-cv-width type="number" min="100" max="1280" step="10" value="480" class="input input-bordered input-sm w-28" />
            </label>
          </div>
        )}

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <button data-cv-run class="btn btn-primary btn-sm">{t.runConvertMedia}</button>
          <button data-cv-clear class="btn btn-ghost btn-sm">{t.clear}</button>
          <span data-cv-status class="text-xs opacity-70" />
        </div>

        {isVideoInput && (
          <div class="mt-4 flex items-start gap-2 rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>{t.safariVideoNote}</span>
          </div>
        )}

        <div data-cv-error class="hidden alert alert-error rounded-lg text-xs py-2 mt-4" />

        <ul data-cv-results class="flex flex-col gap-2 mt-4" />
      </div>
    )
  }

  <p class="text-xs opacity-60 mt-4 flex items-start gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
    </svg>
    <span>{t.privacyNote}</span>
  </p>
</div>

<script>
  import { initConverter } from "../convert/controller";

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-converter]")
      .forEach((el) => initConverter(el));
  }

  // This bundled module runs only once, but the site uses View Transitions, so
  // the DOM is swapped on client-side navigation without re-running scripts.
  // Init immediately for the page that first loads this module, AND on every
  // astro:page-load (fires after each View Transition swap) so widgets reached
  // via client-side navigation get their listeners too. initConverter is
  // idempotent, so the overlap on the initial load is harmless.
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
