---
// The dashboard widget shell: dropzone, loaded-file chips, and an empty
// container the controller fills with whichever views the preset declares.
// Nothing platform-specific lives here — Search Console's four views and App
// Store Connect's five render into the same markup.
import { strings } from "../../analytics/i18n";
import type { Lang, Preset } from "../../analytics/types";

interface Props {
  preset: Preset;
  lang: Lang;
}

const { preset, lang } = Astro.props;
const t = strings[lang];
const copy = preset.copy[lang];
---

<div data-analytics data-preset={preset.id} data-lang={lang} class="not-prose">
  {/* Dropzone — the label wraps the hidden input so the whole area is clickable. */}
  <label
    data-an-drop
    class="flex flex-col items-center justify-center text-center gap-2 rounded-xl border-2 border-dashed border-base-300 bg-base-100 px-6 py-10 cursor-pointer transition hover:border-primary"
  >
    <input data-an-input type="file" multiple accept={preset.accept} class="hidden" />
    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
    </svg>
    <div class="text-lg font-semibold">{copy.dropLabel}</div>
    <div class="text-sm opacity-70">{t.dropHint}</div>
    <span class="btn btn-primary btn-sm mt-2">{t.browse}</span>
    <div class="mt-3 badge badge-accent badge-outline gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 0h10.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5Z" />
      </svg>
      {t.noUploads}
    </div>
  </label>

  <div data-an-error class="hidden alert alert-error rounded-lg text-sm py-2 mt-4"></div>

  <div data-an-files class="hidden mt-4"></div>

  {/* Shown until the first file lands, then swapped for the views. */}
  <section data-an-howto class="mt-6 rounded-xl border border-base-300 bg-base-200 p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide opacity-70">{t.howToTitle}</h2>
    <ol class="mt-2 list-decimal list-inside space-y-1 text-sm opacity-80">
      {copy.howTo.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  {/* Filled by the controller from preset.views. */}
  <div data-an-views class="hidden mt-8"></div>

  <p class="text-xs opacity-60 mt-6 flex items-start gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
    </svg>
    <span>{t.privacyNote}</span>
  </p>
</div>

<script>
  import { initDashboard } from "../../analytics/controller";

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-analytics]")
      .forEach((el) => initDashboard(el));
  }

  // The site uses View Transitions, so this bundled module runs once but the DOM
  // is swapped on client-side navigation. Init immediately for the page that
  // loads it AND on every astro:page-load; initDashboard is idempotent.
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
