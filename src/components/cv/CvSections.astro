---
// The CV itself (no layout): used at the bottom of the "Who am I?" page.
// English content comes from src/data/cv.ts (which also feeds the PDF);
// Spanish from src/data/cv-es.ts.
import TimeLineElement from "./TimeLine.astro";
import * as en from "../../data/cv";
import * as es from "../../data/cv-es";
import type { SiteLang } from "../../i18n/site";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const { profile, education, projects, academicProjects, experience, certifications, skills } =
  lang === "es" ? es : en;

const t =
  lang === "es"
    ? {
        profile: "Perfil",
        experience: "Experiencia",
        projects: "Proyectos",
        education: "Formación",
        academic: "Proyectos académicos",
        certifications: "Certificaciones y licencias",
        skills: "Habilidades",
      }
    : {
        profile: "Profile",
        experience: "Experience",
        projects: "Projects",
        education: "Education",
        academic: "Academic Projects",
        certifications: "Certifications & Licences",
        skills: "Skills",
      };

const timelines = [
  { heading: t.experience, items: experience },
  { heading: t.projects, items: projects },
  { heading: t.education, items: education },
  { heading: t.academic, items: academicProjects },
];
---

<div class="cv">
  <h3 class="cv-title"><span class="cv-dot" aria-hidden="true"></span>{t.profile}</h3>
  <p class="cv-profile">{profile}</p>

  {
    timelines.map((section) => (
      <>
        <h3 class="cv-title">
          <span class="cv-dot" aria-hidden="true" />
          {section.heading}
        </h3>
        <div class="time-line-container mb-10">
          {section.items.map((item) => (
            <TimeLineElement title={item.title} subtitle={item.subtitle}>
              {item.body}
            </TimeLineElement>
          ))}
        </div>
      </>
    ))
  }

  <h3 class="cv-title"><span class="cv-dot" aria-hidden="true"></span>{t.certifications}</h3>
  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {certifications.map((item) => <li>{item}</li>)}
  </ul>

  <h3 class="cv-title"><span class="cv-dot" aria-hidden="true"></span>{t.skills}</h3>
  {
    skills.map((group) => (
      <div class="mb-5">
        <h4 class="text-lg font-bold mb-2">{group.name}</h4>
        <ul class="list-disc md:columns-3 columns-2 mx-6">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .cv-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1.1rem;
  }

  .cv-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    background: #a855f7;
    box-shadow: 0 0 10px #a855f7;
  }

  .cv-profile {
    text-align: justify;
    line-height: 1.6;
    opacity: 0.88;
    margin: 0 0 2.5rem;
  }
</style>
