---
// /projects and /es/projects. Same cards in both languages; only the copy changes.
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../HorizontalCard.astro";
import type { SiteLang } from "../../i18n/site";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const es = lang === "es";

const t = es
  ? {
      title: "Proyectos",
      intro: "Una selección de proyectos académicos, personales y en camino, de ciberseguridad, web, móvil y desarrollo de videojuegos.",
      secCyber: "Ciberseguridad e informática forense",
      secMobile: "Desarrollo móvil y web",
      secGames: "Videojuegos y sistemas",
    }
  : {
      title: "Projects",
      intro: "A selection of academic, personal, and upcoming projects across cyber security, web, mobile and game development.",
      secCyber: "Cyber Security & Forensics",
      secMobile: "Mobile & Web Development",
      secGames: "Game Development & Systems",
    };

type Card = { title: string; img: string; desc: string; url: string; badge: string; target?: string };

const cyber: Card[] = es
  ? [
      {
        title: "UNO — Orquestador seguro de agentes de IA",
        img: "/uno-cover.webp",
        desc: "Coordina varios agentes de Claude Code en un mismo proyecto y trata a cada uno como un trabajador no confiable: worktrees aislados, mínimo privilegio y una compuerta determinista que retiene los cambios de riesgo para que yo los revise.",
        url: "/es/projects/uno",
        target: "_self",
        badge: "CÓDIGO ABIERTO",
      },
      {
        title: "Portfolio personal con hardening de seguridad",
        img: "/portfolio.webp",
        desc: "La web que estás leyendo. Hecha con Astro, Tailwind y Cloudflare Pages, con despliegue continuo desde GitHub. Subí las cabeceras de seguridad HTTP de una D a una A en securityheaders.com configurando HSTS, Content-Security-Policy, X-Frame-Options, Permissions-Policy y otras defensas.",
        url: "https://github.com/yongchivo/yongchivo-portfolio",
        badge: "EN LÍNEA",
      },
      {
        title: "Yongchivo Tools",
        img: "/tools-cover.webp",
        desc: "Un hub de micro-herramientas de ciberseguridad gratuitas y bilingües en tools.yongchivo.com: contraseñas, subredes, EXIF y metadatos de PDF en el navegador, más un verificador de cabeceras de seguridad y un comprobador de filtraciones en Cloudflare Workers.",
        url: "https://tools.yongchivo.com/es",
        target: "_blank",
        badge: "EN LÍNEA",
      },
      {
        title: "Conversor de archivos — Privado, en el navegador",
        img: "/convert-cover.webp",
        desc: "Convierte imágenes (PNG, JPG, WebP, HEIC) y formatos de datos (CSV, JSON, YAML, XML) por completo en tu navegador: nunca se sube nada. Bilingüe (EN/ES), con una página propia para cada conversión.",
        url: "/es/convert",
        target: "_self",
        badge: "EN LÍNEA",
      },
      {
        title: "Panel de analítica",
        img: "/analytics-cover.webp",
        desc: "Suelta tus exportaciones CSV de Google Search Console o App Store Connect y mira lo que sus propios paneles no enseñan: CTR frente a posición, embudos de conversión y periodos lado a lado. Todo en el navegador.",
        url: "/es/analytics",
        target: "_self",
        badge: "EN LÍNEA",
      },
    ]
  : [
      {
        title: "UNO — Secure AI Agent Orchestrator",
        img: "/uno-cover.webp",
        desc: "Coordinates several Claude Code agents on one project, treating every agent as an untrusted worker: isolated worktrees, least privilege and a deterministic gate that holds risky changes for my review.",
        url: "/projects/uno",
        target: "_self",
        badge: "OPEN SOURCE",
      },
      {
        title: "Personal Portfolio with Security Hardening",
        img: "/portfolio.webp",
        desc: "The site you are reading right now. Built with Astro, Tailwind and Cloudflare Pages, with continuous deployment from GitHub. Hardened HTTP security headers from grade D to A on securityheaders.com by configuring HSTS, Content-Security-Policy, X-Frame-Options, Permissions-Policy and other defences.",
        url: "https://github.com/yongchivo/yongchivo-portfolio",
        badge: "LIVE",
      },
      {
        title: "Yongchivo Tools",
        img: "/tools-cover.webp",
        desc: "A hub of free, bilingual (EN/ES) cybersecurity micro-tools at tools.yongchivo.com — password, subnet, EXIF and PDF-metadata utilities that run in the browser, plus a Security Headers Checker and a Breach Checker on Cloudflare Workers.",
        url: "https://tools.yongchivo.com",
        target: "_blank",
        badge: "LIVE",
      },
      {
        title: "File Converter — Private, In-Browser",
        img: "/convert-cover.webp",
        desc: "Convert images (PNG, JPG, WebP, HEIC) and data formats (CSV, JSON, YAML, XML) entirely in your browser — nothing is ever uploaded. Bilingual (EN/ES), with a dedicated page per conversion.",
        url: "/convert",
        target: "_self",
        badge: "LIVE",
      },
      {
        title: "Analytics Dashboard",
        img: "/analytics-cover.webp",
        desc: "Drop in your Google Search Console or App Store Connect CSV exports and see what their own dashboards don't show: CTR against position, conversion funnels and side-by-side date ranges. Runs entirely in the browser.",
        url: "/analytics",
        target: "_self",
        badge: "LIVE",
      },
    ];

const mobile: Card[] = es
  ? [
      {
        title: "PHV Prep UK — App para el examen de taxi",
        img: "/phv-prep-uk.webp",
        desc: "Preparación para los exámenes de licencia de private hire («taxi badge») de West Midlands, en iOS y Android: más de 2.000 preguntas, simulacros cronometrados y un tutor de IA de la normativa del taxi en Reino Unido. Hecha en solitario con Flutter y Firebase, con las compras verificadas en el servidor y la clave de IA fuera de la app. (Página en inglés.)",
        url: "/phv-prep-uk",
        target: "_self",
        badge: "EN LÍNEA",
      },
      {
        title: "MyLocation — App Android",
        img: "/mylocation.webp",
        desc: "Una app Android basada en la ubicación, con Google Firebase como backend: autenticación de usuarios y almacenamiento en tiempo real para sincronizar ubicaciones y eventos entre dispositivos. Hecha en Java/Kotlin para el módulo de Mobile Application Development.",
        url: "https://github.com/yongchivo/MyLocation",
        badge: "TRABAJO DE CLASE",
      },
    ]
  : [
      {
        title: "PHV Prep UK — Taxi Badge Exam Prep App",
        img: "/phv-prep-uk.webp",
        desc: "Exam prep for West Midlands private hire (\"taxi badge\") licensing tests, on iOS and Android: 2,000+ practice questions, timed mock exams and an AI tutor for UK taxi law. Built solo with Flutter and Firebase, with purchases verified server-side and the AI key never shipped in the app.",
        url: "/phv-prep-uk",
        target: "_self",
        badge: "LIVE",
      },
      {
        title: "MyLocation — Android App",
        img: "/mylocation.webp",
        desc: "A location-aware Android app backed by Google Firebase, with user authentication and real-time data storage to sync locations and events across devices. Built in Java/Kotlin as part of the Mobile Application Development module.",
        url: "https://github.com/yongchivo/MyLocation",
        badge: "COURSEWORK",
      },
    ];

const games: Card[] = es
  ? [
      {
        title: "BlackDogHunter — Videojuego 2D",
        img: "/blackdoghunter.webp",
        desc: "Un videojuego 2D completo hecho en Unity con C#: mecánicas, animación de sprites, gestión de escenas y diseño de niveles. Empezó como proyecto académico en grupo cuyo entregable era un informe de equipo; el código lo escribí yo desde cero.",
        url: "https://github.com/yongchivo/Assignment_Platform_Game",
        badge: "TRABAJO DE CLASE",
      },
      {
        title: "Sistema operativo de quiosco universitario",
        img: "/kiosk-os.webp",
        desc: "Un sistema de quiosco bloqueado basado en Ubuntu, con inicio de sesión automático, entorno de usuario restringido y scripts de arranque para ofrecer un terminal público fiable y de un solo uso. Hecho para el módulo de Operating Systems, para practicar administración de Linux, políticas de seguridad y hardening del sistema.",
        url: "https://github.com/yongchivo/UW_kiosk_setup",
        badge: "TRABAJO DE CLASE",
      },
    ]
  : [
      {
        title: "BlackDogHunter — 2D Game",
        img: "/blackdoghunter.webp",
        desc: "A complete 2D game built in Unity with C#, covering game mechanics, sprite animation, scene management and level design. Originally developed as a group academic project where the deliverable was a team report — the codebase itself was built from scratch by me.",
        url: "https://github.com/yongchivo/Assignment_Platform_Game",
        badge: "COURSEWORK",
      },
      {
        title: "University Kiosk Operating System",
        img: "/kiosk-os.webp",
        desc: "A locked-down kiosk OS based on Ubuntu, with auto-login, restricted user environment and start-up scripts to deliver a reliable single-purpose public terminal. Built as part of the Operating Systems module to explore Linux administration, security policies and system hardening.",
        url: "https://github.com/yongchivo/UW_kiosk_setup",
        badge: "COURSEWORK",
      },
    ];

const sections = [
  { heading: t.secCyber, cards: cyber, top: "mt-6" },
  { heading: t.secMobile, cards: mobile, top: "mt-10" },
  { heading: t.secGames, cards: games, top: "mt-10" },
];

// TODO: Add "Practical Tools & Side Projects" section once first real-world project is built
---

{/* Hidden for now, kept verbatim from the original projects.astro (EN only):
   <HorizontalCard
    title="LLM-Powered Forensic Assistant"
    img="/llm-forensic.webp"
    desc="My upcoming Final Year dissertation project (2026/27). Exploring how large language models can assist digital forensic investigators with evidence triage, timeline reconstruction and report drafting. Researching prompt design, hallucination mitigation and the role of human-in-the-loop verification in forensic workflows."
    url="#"
    badge="DISSERTATION"
  /> 
   <HorizontalCard
  title="TeamTill — Employee Management App"
  img="/teamtill.webp"
  desc="A self-directed cross-platform mobile app (iOS and Android), built around a realistic scenario: a small retail shop that needs secure clock-in/out, schedule management and access to employment documents. Built with React Native (Expo) and Firebase. Security-focused by design: GDPR-conscious handling of employee data, EU-region storage (europe-west1), role-based Firestore and Storage rules restricting payslip access to the owning employee or an administrator, and Firebase credentials kept out of version control. Currently in development."
  url="https://github.com/yongchivo/Employee-Management-Mobile-Application-for-Retail"
  badge="PERSONAL PROJECT"
  /> 
*/}

<BaseLayout
  title={t.title}
  lang={lang}
  sideBarActiveItemID="projects"
  alternates={{ en: "/projects", es: "/es/projects" }}
>
  <div class="mb-5">
    <h1 class="text-3xl w-fit font-bold bg-gradient-to-r from-brand-magenta via-brand-purple to-brand-cyan bg-clip-text text-transparent">{t.title}</h1>
    <div class="mt-2 mb-6 opacity-80">{t.intro}</div>
  </div>

  {
    sections.map((section) => (
      <>
        <h2 class={`text-2xl w-full font-bold mb-3 ${section.top}`}>{section.heading}</h2>
        {section.cards.map((c, i) => (
          <>
            {i > 0 && <div class="divider my-0" />}
            <HorizontalCard title={c.title} img={c.img} desc={c.desc} url={c.url} target={c.target} badge={c.badge} />
          </>
        ))}
      </>
    ))
  }
</BaseLayout>
