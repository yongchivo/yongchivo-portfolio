---
// The /tools/ hub: one page that gathers everything I've shipped, grouped by
// what it is rather than where it's hosted. The cybersecurity tools live on
// tools.yongchivo.com (external); the converter and the analytics dashboard
// live on this site. Nothing moves — this is just the door.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { conversions, getConversion, type Conversion, type Lang } from "../../convert/registry";
import { livePresets } from "../../analytics/presets";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEs = lang === "es";

const convertBase = isEs ? "/es/convert" : "/convert";
const analyticsBase = isEs ? "/es/analytics" : "/analytics";
// tools.yongchivo.com mirrors this site's EN/ES split under /es/.
const toolsBase = isEs ? "https://tools.yongchivo.com/es" : "https://tools.yongchivo.com";

const title = isEs
  ? "Herramientas — Ciberseguridad, Conversor de Archivos y más | Yongchivo"
  : "Tools — Cybersecurity, File Converter & More | Yongchivo";
const description = isEs
  ? "Todas mis herramientas gratuitas en un solo sitio: micro-herramientas de ciberseguridad, un conversor de archivos y un panel de analítica que funcionan 100% en tu navegador."
  : "Every free tool I've built, in one place: privacy-first cybersecurity utilities, a file converter and an analytics dashboard that run 100% in your browser.";

const t = isEs
  ? {
      h1: "Herramientas",
      intro: "Herramientas pequeñas y enfocadas: gratis, privadas y sin registro.",
      orbConvert: "Conversor",
      newTab: "(abre tools.yongchivo.com en una pestaña nueva)",
      secCyber: "Ciberseguridad",
      secCyberIntro:
        "Micro-herramientas privadas alojadas en tools.yongchivo.com. Las herramientas de cliente nunca envían tus datos a ningún sitio.",
      secConvert: "Conversor de archivos",
      secConvertIntro:
        "Conversión de archivos gratis y privada que se ejecuta por completo en tu navegador.",
      secAnalytics: "Analítica",
      secAnalyticsIntro:
        "Sube la exportación de una plataforma y léela como debería leerse — todo en tu navegador, sin subir nada.",
      analyticsCardTitle: "Abrir el panel",
      convertCardTitle: "Ver todas las conversiones",
      convertCardDesc: (n: number) =>
        `${n} conversiones disponibles — imágenes, datos, PDF, Word, audio y vídeo. Nada se sube a un servidor.`,
      featured: "Más usadas",
      analyticsName: "Panel de analítica",
      analyticsDesc:
        "Google Search Console, App Store Connect y Google Play Console: totales, tendencias, embudos y comparación entre periodos — 100% en tu navegador.",
    }
  : {
      h1: "Tools",
      intro: "Small, focused tools — free, private and no sign-up.",
      orbConvert: "File Converter",
      newTab: "(opens tools.yongchivo.com in a new tab)",
      secCyber: "Cybersecurity",
      secCyberIntro:
        "Privacy-first micro-tools hosted at tools.yongchivo.com. The client-side ones never send your data anywhere.",
      secConvert: "File Converter",
      secConvertIntro:
        "Free, private file conversion that runs entirely in your browser.",
      secAnalytics: "Analytics",
      secAnalyticsIntro:
        "Upload a platform export and read it the way it should have been shown to you — all in your browser, nothing uploaded.",
      analyticsCardTitle: "Open the dashboard",
      convertCardTitle: "Browse every conversion",
      convertCardDesc: (n: number) =>
        `${n} conversions available — images, data, PDF, Word, audio and video. Nothing is ever uploaded.`,
      featured: "Most popular",
      analyticsName: "Analytics Dashboard",
      analyticsDesc:
        "Google Search Console, App Store Connect and Google Play Console: totals, trends, funnels and period comparison — 100% in your browser.",
    };

// The cybersecurity tools, in the same order as the hub at tools.yongchivo.com.
// Names and blurbs are that site's own copy so the two hubs read as one product.
const cyberTools: { slug: string; name: string; desc: string }[] = isEs
  ? [
      {
        slug: "password-generator",
        name: "Generador de contraseñas",
        desc: "Crea contraseñas fuertes y aleatorias íntegramente en tu navegador.",
      },
      {
        slug: "password-strength",
        name: "Analizador de fortaleza de contraseñas",
        desc: "Comprueba cuánto resiste una contraseña frente a ataques — nada sale de tu dispositivo.",
      },
      {
        slug: "subnet-calculator",
        name: "Calculadora de subredes",
        desc: "Calcula rangos de red, máscaras y hosts a partir de cualquier bloque CIDR.",
      },
      {
        slug: "security-headers",
        name: "Verificador de cabeceras de seguridad",
        desc: "Pega una URL y audita sus cabeceras de seguridad HTTP en segundos.",
      },
      {
        slug: "breach-check",
        name: "Comprobador de filtraciones",
        desc: "Descubre si una cuenta aparece en filtraciones de datos conocidas.",
      },
      {
        slug: "which-cyber-role",
        name: "¿Qué rol cyber eres?",
        desc: "Un test rápido para encontrar tu perfil: pentester, analista SOC, forense y más.",
      },
      {
        slug: "exif-viewer",
        name: "Visor EXIF",
        desc: "Mira los metadatos ocultos de una foto — cámara, fecha y hasta la ubicación GPS. 100% en tu navegador.",
      },
      {
        slug: "pdf-metadata",
        name: "Editor de metadatos PDF",
        desc: "Inspecciona y elimina los metadatos ocultos de un PDF — autor, software y fechas.",
      },
    ]
  : [
      {
        slug: "password-generator",
        name: "Password Generator",
        desc: "Create strong, random passwords entirely in your browser.",
      },
      {
        slug: "password-strength",
        name: "Password Strength Analyzer",
        desc: "Check how resistant a password is to cracking — nothing leaves your device.",
      },
      {
        slug: "subnet-calculator",
        name: "Subnet Calculator",
        desc: "Work out network ranges, masks and hosts from any CIDR block.",
      },
      {
        slug: "security-headers",
        name: "Security Headers Checker",
        desc: "Paste a URL and audit its HTTP security headers in seconds.",
      },
      {
        slug: "breach-check",
        name: "Breach Checker",
        desc: "Find out if an account appears in known data breaches.",
      },
      {
        slug: "which-cyber-role",
        name: "Which Cyber Role Are You?",
        desc: "A quick quiz to find your fit: pentester, SOC analyst, forensics and more.",
      },
      {
        slug: "exif-viewer",
        name: "EXIF Viewer",
        desc: "See the hidden metadata in a photo — camera, timestamp, even GPS location. 100% in your browser.",
      },
      {
        slug: "pdf-metadata",
        name: "PDF Metadata Editor",
        desc: "Inspect and strip the hidden metadata in a PDF — author, software and timestamps.",
      },
    ];

// One small line icon per tool (24x24, stroked), keyed by slug, plus a few
// shared ones. Static strings, rendered with set:html.
const icons: Record<string, string> = {
  "password-generator": '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3M15 8l2 2"/>',
  "password-strength": '<path d="M4 17a8 8 0 1 1 16 0"/><path d="M12 17l4-5"/><circle cx="12" cy="17" r="1"/>',
  "subnet-calculator": '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-2h12v2"/>',
  "security-headers": '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  "breach-check": '<path d="M12 4l9 16H3L12 4z"/><path d="M12 10v4M12 17h.01"/>',
  "which-cyber-role": '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>',
  "exif-viewer": '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7l2-3h4l2 3"/><circle cx="12" cy="13.5" r="3.5"/>',
  "pdf-metadata": '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 13h6M9 17h6"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/>',
  swap: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
};

// Counted from the registries so the numbers can never drift from what's shipped.
const conversionCount = conversions.length;
const dashboards = livePresets();

// A handful of the most-searched conversions, straight from the registry so the
// cards match the ones on the /convert/ landing.
const featured = ["heic-to-jpg", "png-to-jpg", "mp4-to-mp3", "merge-pdf", "csv-to-json"]
  .map((id) => getConversion(id))
  .filter((c): c is Conversion => Boolean(c));

// The three category bubbles at the top, in the home bubble's colours.
const orbs = [
  { href: "#cyber", label: t.secCyber, count: cyberTools.length, icon: "shield", tone: "cyan" },
  { href: "#convert", label: t.orbConvert, count: conversionCount, icon: "swap", tone: "magenta" },
  { href: "#analytics", label: t.secAnalytics, count: dashboards.length, icon: "chart", tone: "purple" },
];
---

<BaseLayout title={title} description={description} lang={lang} sideBarActiveItemID="tools">
  <link slot="head" rel="alternate" hreflang="en" href={new URL("/tools/", Astro.site)} />
  <link slot="head" rel="alternate" hreflang="es" href={new URL("/es/tools/", Astro.site)} />
  <link slot="head" rel="alternate" hreflang="x-default" href={new URL("/tools/", Astro.site)} />

  <div class="tools" data-tools>
    <h1 class="tools-title">{t.h1.toUpperCase()}</h1>
    <p class="tools-intro">{t.intro}</p>

    <ul class="orbs">
      {
        orbs.map((orb, i) => (
          <li>
            <a href={orb.href} class={`orb tone-${orb.tone}`} style={`--i:${i}`}>
              <span class="orb-ball">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[orb.icon]} />
                <span class="orb-count">{orb.count}</span>
              </span>
              <span class="orb-label">{orb.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <section id="cyber" class="tools-section tone-cyan">
      <div class="section-head">
        <span class="section-dot" aria-hidden="true"></span>
        <h2 class="section-title">{t.secCyber}</h2>
        <span class="section-count">{cyberTools.length}</span>
      </div>
      <p class="section-intro">{t.secCyberIntro}</p>
      <ul class="card-grid">
        {
          cyberTools.map((tool, i) => (
            <li class="reveal" style={`--d:${i % 6}`}>
              <a href={`${toolsBase}/${tool.slug}/`} target="_blank" rel="noopener" class="tool-card">
                <span class="tool-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[tool.slug]} />
                </span>
                <span>
                  <span class="tool-name">
                    {tool.name}
                    <svg class="tool-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.external} />
                    <span class="sr-only">{t.newTab}</span>
                  </span>
                  <span class="tool-desc">{tool.desc}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="convert" class="tools-section tone-magenta">
      <div class="section-head">
        <span class="section-dot" aria-hidden="true"></span>
        <h2 class="section-title">{t.secConvert}</h2>
        <span class="section-count">{conversionCount}</span>
      </div>
      <p class="section-intro">{t.secConvertIntro}</p>

      <div class="reveal">
        <a href={`${convertBase}/`} class="cta-card">
          <span>
            <span class="cta-title">{t.convertCardTitle}</span>
            <span class="cta-desc">{t.convertCardDesc(conversionCount)}</span>
          </span>
          <span class="cta-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
          </span>
        </a>
      </div>

      <h3 class="chips-label">{t.featured}</h3>
      <ul class="chips">
        {
          featured.map((c, i) => (
            <li class="reveal" style={`--d:${i}`}>
              <a href={`${convertBase}/${c.id}/`} class="chip">
                {c.from && c.to ? (
                  <>
                    <span class="chip-from">{c.from}</span>
                    <svg class="chip-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
                    <span class="chip-to">{c.to}</span>
                  </>
                ) : (
                  <span class="chip-to">{c.copy[lang].h1}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="analytics" class="tools-section tone-purple">
      <div class="section-head">
        <span class="section-dot" aria-hidden="true"></span>
        <h2 class="section-title">{t.secAnalytics}</h2>
        <span class="section-count">{dashboards.length}</span>
      </div>
      <p class="section-intro">{t.secAnalyticsIntro}</p>
      {/* One card per live preset, straight from the registry, so promoting a
          preset shows up here without this file being touched. */}
      <ul class="card-grid">
        {
          dashboards.map((preset, i) => (
            <li class="reveal" style={`--d:${i}`}>
              <a href={`${analyticsBase}/${preset.id}/`} class="tool-card">
                <span class="tool-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.chart} />
                </span>
                <span>
                  <span class="tool-name">{preset.copy[lang].cardTitle}</span>
                  <span class="tool-desc">{preset.copy[lang].cardDesc}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more-link">
        <a href={`${analyticsBase}/`}>{t.analyticsCardTitle} →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
.tools {
  --magenta: #d946ef;
  --purple: #a855f7;
  --cyan: #22d3ee;
  --surface: #131120;
  --surface-2: #1c1a2e;
  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}
@supports (transition-timing-function: linear(0, 1)) {
  .tools {
    --spring: linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1);
  }
}
.tone-cyan { --tone: var(--cyan); --tone-soft: rgba(34, 211, 238, 0.14); }
.tone-magenta { --tone: var(--magenta); --tone-soft: rgba(217, 70, 239, 0.14); }
.tone-purple { --tone: var(--purple); --tone-soft: rgba(168, 85, 247, 0.16); }

/* ---------- title ---------- */
.tools-title {
  text-align: center;
  font-weight: 700;
  /* Long words (HERRAMIENTAS) must still fit a 360px phone. */
  font-size: clamp(1.6rem, 7.5vw, 3rem);
  letter-spacing: 0.18em;
  margin: 0 -0.18em 0 0;
  background: linear-gradient(to right, var(--magenta), var(--purple), var(--cyan));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.tools-intro {
  text-align: center;
  opacity: 0.7;
  margin: 0.75rem auto 0;
  max-width: 32rem;
}

/* ---------- category orbs ---------- */
.orbs {
  display: flex;
  justify-content: center;
  gap: clamp(1.25rem, 6vw, 3.5rem);
  margin: 2.75rem 0 3.5rem;
  list-style: none;
  padding: 0;
}
.orb {
  display: grid;
  justify-items: center;
  gap: 0.7rem;
  text-align: center;
}
.orb-ball {
  position: relative;
  width: clamp(4.75rem, 18vw, 6.5rem);
  aspect-ratio: 1;
  border-radius: 9999px;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 32%),
    radial-gradient(circle at 70% 80%, var(--tone-soft), transparent 60%),
    var(--surface);
  border: 1px solid rgba(232, 230, 242, 0.14);
  box-shadow: inset 0 -10px 20px rgba(0, 0, 0, 0.4), 0 0 26px -6px var(--tone);
  color: var(--tone);
  transition: transform 0.5s var(--spring), box-shadow 0.3s ease;
}
.orb-ball svg { width: 42%; height: 42%; }
.orb-count {
  position: absolute;
  top: -0.2rem;
  right: -0.35rem;
  min-width: 1.7rem;
  height: 1.7rem;
  padding: 0 0.4rem;
  border-radius: 9999px;
  display: grid;
  place-items: center;
  font-size: 0.75rem;
  font-weight: 700;
  color: #0b0a14;
  background: var(--tone);
}
.orb-label { font-weight: 600; font-size: 0.95rem; }
.orb:hover .orb-ball,
.orb:focus-visible .orb-ball {
  transform: translateY(-6px) scale(1.06);
  box-shadow: inset 0 -10px 20px rgba(0, 0, 0, 0.4), 0 0 38px -4px var(--tone);
}
.orb:focus-visible { outline: none; }
.orb:focus-visible .orb-ball { outline: 2px solid var(--tone); outline-offset: 5px; }

/* ---------- sections ---------- */
.tools-section { margin-bottom: 3.5rem; scroll-margin-top: 1.5rem; }
.section-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; }
.section-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 9999px;
  background: var(--tone);
  box-shadow: 0 0 12px var(--tone);
}
.section-title { font-size: 1.35rem; font-weight: 700; margin: 0; }
.section-count {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.15rem 0.55rem;
  border-radius: 9999px;
  color: var(--tone);
  border: 1px solid var(--tone);
}
.section-intro { font-size: 0.875rem; opacity: 0.65; margin: 0 0 1.1rem 1.45rem; max-width: 40rem; }

/* ---------- tool cards ---------- */
.card-grid { display: grid; gap: 0.85rem; list-style: none; padding: 0; margin: 0; }
@media (min-width: 640px) { .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

.tool-card {
  position: relative;
  display: flex;
  gap: 0.9rem;
  align-items: flex-start;
  padding: 1rem 1.1rem;
  border-radius: 1rem;
  background: var(--surface);
  border: 1px solid var(--surface-2);
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.4s var(--spring);
}
.tool-card:hover,
.tool-card:focus-visible {
  border-color: var(--tone);
  box-shadow: 0 0 24px -8px var(--tone);
}
.tool-card:focus-visible { outline: 2px solid var(--tone); outline-offset: 3px; }
@media (prefers-reduced-motion: no-preference) {
  .tool-card:hover { transform: translateY(-3px); }
}
.tool-icon {
  flex: none;
  width: 2.6rem;
  height: 2.6rem;
  border-radius: 9999px;
  display: grid;
  place-items: center;
  color: var(--tone);
  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.14), transparent 45%), var(--tone-soft);
  border: 1px solid rgba(232, 230, 242, 0.1);
  transition: transform 0.45s var(--spring);
}
.tool-icon svg { width: 1.25rem; height: 1.25rem; }
@media (prefers-reduced-motion: no-preference) {
  .tool-card:hover .tool-icon { transform: scale(1.12) rotate(-6deg); }
}
.tool-name { display: block; font-weight: 600; }
.tool-desc { display: block; font-size: 0.85rem; opacity: 0.7; margin-top: 0.2rem; line-height: 1.4; }
.tool-ext { display: inline-block; width: 0.85rem; height: 0.85rem; margin-left: 0.3rem; vertical-align: -1px; opacity: 0.45; }

/* converter: the big "all conversions" card + format chips */
.cta-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.15rem 1.3rem;
  margin-bottom: 1rem;
  border-radius: 1rem;
  background:
    radial-gradient(circle at 0% 0%, var(--tone-soft), transparent 55%),
    var(--surface);
  border: 1px solid var(--tone);
  transition: box-shadow 0.25s ease;
}
.cta-card:hover, .cta-card:focus-visible { box-shadow: 0 0 28px -8px var(--tone); }
.cta-card:focus-visible { outline: 2px solid var(--tone); outline-offset: 3px; }
.cta-title { display: block; font-weight: 700; font-size: 1.05rem; }
.cta-desc { display: block; font-size: 0.85rem; opacity: 0.7; margin-top: 0.15rem; }
.cta-arrow {
  flex: none;
  width: 2.4rem; height: 2.4rem; border-radius: 9999px;
  display: grid; place-items: center;
  background: var(--tone); color: #0b0a14;
  transition: transform 0.45s var(--spring);
}
.cta-arrow svg { width: 1.1rem; height: 1.1rem; }
@media (prefers-reduced-motion: no-preference) {
  .cta-card:hover .cta-arrow { transform: translateX(4px) scale(1.08); }
}

.chips-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.55; margin: 0 0 0.6rem; }
.chips { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; padding: 0; margin: 0; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 0.9rem;
  border-radius: 9999px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.85rem;
  font-weight: 600;
  background: var(--surface);
  border: 1px solid var(--surface-2);
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}
.chip:hover, .chip:focus-visible { border-color: var(--tone); box-shadow: 0 0 18px -6px var(--tone); }
.chip:focus-visible { outline: 2px solid var(--tone); outline-offset: 3px; }
.chip-from { opacity: 0.75; }
.chip-to { color: var(--tone); }
.chip-arrow { width: 0.9rem; height: 0.9rem; opacity: 0.6; transition: transform 0.35s var(--spring); }
@media (prefers-reduced-motion: no-preference) {
  .chip:hover .chip-arrow { transform: translateX(3px); }
}

.more-link { margin: 1rem 0 0; font-size: 0.875rem; }
.more-link a { color: var(--tone); opacity: 0.85; }
.more-link a:hover, .more-link a:focus-visible { opacity: 1; text-decoration: underline; }

/* ---------- motion: float + entrance (only if allowed) ---------- */
@media (prefers-reduced-motion: no-preference) {
  .orb-ball { animation: orb-float 5s ease-in-out infinite; animation-delay: calc(var(--i) * -1.6s); }
  .orb:hover .orb-ball, .orb:focus-visible .orb-ball { animation-play-state: paused; }

  .reveal-ready .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s ease, transform 0.6s var(--spring);
    transition-delay: calc(var(--d, 0) * 60ms);
  }
  .reveal-ready .reveal.is-visible { opacity: 1; transform: none; }
}
@keyframes orb-float {
  0%, 100% { translate: 0 0; }
  50% { translate: 0 -7px; }
}
</style>

<script>
  // Cards fade up as they scroll into view — only when motion is allowed and
  // IntersectionObserver exists; otherwise everything is simply visible.
  function initReveal() {
    if (!("IntersectionObserver" in window)) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLElement>("[data-tools]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      root.classList.add("reveal-ready");
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }),
        { rootMargin: "0px 0px -8% 0px" },
      );
      root.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    });
  }

  // Same pattern as ConverterApp.astro: run now, and after every View
  // Transition swap (bundled scripts only execute once).
  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
