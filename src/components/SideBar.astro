---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
import { localize, ui } from "../i18n/site";
const { sideBarActiveItemID, lang = "en" } = Astro.props;
// The home bubble and this logo share the view-transition-name "brand-logo", so
// the Y morphs from one to the other. On the home page the bubble owns the
// name: two elements with the same name on one page would cancel the morph.
const logoStyle = sideBarActiveItemID === "home" ? undefined : "view-transition-name: brand-logo";
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">
    <div class="w-fit mx-auto mt-5 mb-6">
      <a href={localize("/", lang)}>
        <div class="avatar transition ease-in-out motion-safe:hover:scale-[102%] block m-auto">
          <div class="sidebar-logo w-[8.5rem] rounded-full" style={logoStyle}>
            <Image class="mask mask-circle" format="webp" width={300} height={300} src="/profile.webp" alt={ui[lang].logoAlt} />
          </div>
        </div>
      </a>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} lang={lang} />
    <SideBarFooter />
  </aside>
</div>
