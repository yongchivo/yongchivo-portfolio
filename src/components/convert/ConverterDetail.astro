---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConverterApp from "../ConverterApp.astro";
import { getConversion, type Conversion, type Lang } from "../../convert/registry";
import { strings } from "../../convert/i18n";

interface Props {
  conversion: Conversion;
  lang: Lang;
}

const { conversion, lang } = Astro.props;
const t = strings[lang];
const copy = conversion.copy[lang];

const base = lang === "es" ? "/es/convert" : "/convert";
const enPath = `/convert/${conversion.id}/`;
const esPath = `/es/convert/${conversion.id}/`;
const otherLangPath = lang === "es" ? enPath : esPath;

const related = conversion.related
  .map((id) => getConversion(id))
  .filter((c): c is Conversion => Boolean(c));
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} sideBarActiveItemID="tools">
  <link slot="head" rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
  <link slot="head" rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
  <link slot="head" rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />

  <nav class="text-sm opacity-70 mb-4 flex items-center gap-2 flex-wrap">
    <a href={`${base}/`} class="link link-hover">{t.backToAll}</a>
    <span>/</span>
    <span class="font-medium opacity-100">
      {conversion.from && conversion.to ? `${conversion.from} → ${conversion.to}` : copy.h1}
    </span>
    <a href={otherLangPath} class="badge badge-outline ml-auto">{lang === "es" ? "EN" : "ES"}</a>
  </nav>

  <header class="mb-6">
    <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-brand-magenta via-brand-purple to-brand-cyan bg-clip-text text-transparent w-fit">
      {copy.h1}
    </h1>
    <p class="mt-3 opacity-80 max-w-2xl">{copy.intro}</p>
  </header>

  <ConverterApp conversion={conversion} lang={lang} />

  <section class="mt-10">
    <h2 class="text-xl font-bold mb-3">{t.relatedTitle}</h2>
    <div class="grid gap-3 sm:grid-cols-3">
      {
        related.map((c) => (
          <a
            href={`${base}/${c.id}/`}
            class="rounded-lg border border-base-300 bg-base-200 px-4 py-3 transition hover:border-primary"
          >
            <div class="font-mono text-sm font-semibold">
              {c.from && c.to ? `${c.from} → ${c.to}` : c.copy[lang].h1}
            </div>
            <div class="mt-1 text-xs opacity-70">{c.copy[lang].card}</div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
