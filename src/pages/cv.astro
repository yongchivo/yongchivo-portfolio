---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import {
  profile,
  education,
  projects,
  academicProjects,
  experience,
  certifications,
  skills,
} from "../data/cv";
---

<BaseLayout title="CV" sideBarActiveItemID="cv">
  <div
    class="mb-5 flex flex-wrap items-center justify-between gap-4"
  >
    <div class="text-3xl font-bold">Profile</div>
    <a
      href="/cv/john-cv.pdf"
      download
      class="btn btn-primary gap-2"
      aria-label="Download this CV as a PDF"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 16 7 11l1.41-1.41L11 12.17V4h2v8.17l2.59-2.58L17 11l-5 5Z"
        ></path>
        <path d="M5 18h14v2H5z"></path>
      </svg>
      Download PDF
    </a>
  </div>

  <div class="mb-10 text-justify">
    {profile}
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    {
      education.map((item) => (
        <TimeLineElement title={item.title} subtitle={item.subtitle}>
          {item.body}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Projects</div>
  </div>

  <div class="time-line-container mb-10">
    {
      projects.map((item) => (
        <TimeLineElement title={item.title} subtitle={item.subtitle}>
          {item.body}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Academic Projects</div>
  </div>

  <div class="time-line-container mb-10">
    {
      academicProjects.map((item) => (
        <TimeLineElement title={item.title} subtitle={item.subtitle}>
          {item.body}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    {
      experience.map((item) => (
        <TimeLineElement title={item.title} subtitle={item.subtitle}>
          {item.body}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications & Licences</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {certifications.map((item) => <li>{item}</li>)}
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  {
    skills.map((group) => (
      <div class="mb-5">
        <div class="text-xl font-bold mb-2">{group.name}</div>
        <ul class="list-disc md:columns-3 columns-2 mx-6">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</BaseLayout>
