---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold w-fit bg-gradient-to-r from-brand-magenta via-brand-purple to-brand-cyan bg-clip-text text-transparent">I'm John Akhis Moreno</div>
    <div class="text-2xl py-1 text-gray-500">Yongchivo</div>
    <div class="text-3xl py-3 font-bold">Cyber Security Student & Builder</div>
    <div class="py-2">
      <p class="text-lg">
        Welcome! I'm a Cyber Security student at the <b>University of Worcester</b>, passionate about AI, Digital Forensics, and Game Development.
        I build, experiment, and share what I learn along the way — from successes to failures.
        This is my space to document the journey.
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://github.com/yongchivo" target="_blank">GitHub</a>
      <a href="mailto:contact@yongchivo.com" class="btn btn-outline ml-5">
        Get in touch
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My latest projects</div>
  </div>

<HorizontalCard
  title="Yongchivo Tools"
  img="/tools-cover.webp"
  desc="A hub of free, bilingual (EN/ES) cybersecurity micro-tools at tools.yongchivo.com — six tools now live. Client-side utilities that run entirely in the browser: Password Generator, Password Strength Analyzer, Subnet Calculator and a 'Which cyber role are you?' quiz; plus two Cloudflare Worker-backed tools — a Security Headers Checker (with strict SSRF-safe URL validation) and a Breach Checker (XposedOrNot). Built with Astro, Tailwind and Cloudflare Workers, with automatic deploys and its own A-grade security headers."
  url="https://tools.yongchivo.com"
  target="_blank"
  badge="LIVE"
/>
<div class="divider my-0"></div>
<HorizontalCard
    title="PHV Prep UK — iOS Exam Prep App"
    img="/phv-prep-uk.webp"
    desc="My first app submitted to the App Store: exam preparation for the Wolverhampton private hire vehicle (&quot;taxi badge&quot;) licensing test. 300+ practice questions, realistic timed mock exams that mirror the real exam's pass logic, and an AI tutor for UK taxi law. Built solo with Flutter and Firebase (Auth, Firestore, Cloud Functions, europe-west2). Security-focused: server-side StoreKit 2 purchase verification, the Anthropic API key kept entirely server-side in Secret Manager (never shipped in the client), Firestore rules locking premium status to the backend, and content-safety controls on the AI feature."
    url="/phv-prep-uk"
    target="_self"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
<HorizontalCard
  title="BlackDogHunter — 2D Game"
  img="/blackdoghunter.webp"
  desc="A complete 2D game built in Unity with C#, covering game mechanics, sprite animation, scene management and level design."
  url="https://github.com/yongchivo/Assignment_Platform_Game"
  badge="COURSEWORK"
/>
<div class="divider my-0"></div>
<HorizontalCard
  title="University Kiosk Operating System"
  img="/kiosk-os.webp"
  desc="A locked-down kiosk OS based on Ubuntu, with auto-login, restricted user environment and start-up scripts for a reliable single-purpose public terminal."
  url="https://github.com/yongchivo/UW_kiosk_setup"
  badge="COURSEWORK"
/>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {/* Newest first — keep in sync with the listing in blog/[...page].astro */}
  <HorizontalCard
    title="Launching Yongchivo Tools: six cybersecurity micro-tools, bilingual, no tracking"
    img="/post-yongchivo-tools.webp"
    desc="I just shipped a hub of six free cybersecurity tools — built with Astro and Cloudflare Workers, with Claude Code as my only development hands. Here's what's live, an SSRF hardening story, a real secret-leak-and-rotation incident, and the day my own tool gave my own site an F."
    url="/blog/yongchivo-tools-launch"
    target="_self"
    badge="SECURITY"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Join the PHV Prep UK Android Beta — Test It Now"
    img="/images/join-android-beta.png"
    desc="PHV Prep UK is in closed beta on Android. Opt in and download it directly using the links below."
    url="/phv-prep-uk/blog/join-android-beta/"
    target="_self"
    badge="ANDROID BETA"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="We Made a Promo Video for PHV Prep UK"
    img="/images/promo-video-announcement.png"
    desc="Check out our new promotional video for PHV Prep UK — the exam prep app for the Wolverhampton private hire test."
    url="/phv-prep-uk/blog/promo-video/"
    target="_self"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Help Us Test PHV Prep UK on Android — Be a Beta Tester"
    img="/images/android-beta-testers.png"
    desc="PHV Prep UK is coming to Android. We need 12 beta testers before we can launch on the Play Store. Join now — it's free."
    url="/phv-prep-uk/blog/android-beta-testers/"
    target="_self"
    badge="ANDROID BETA"
  />
  <div class="divider my-0"></div>
</BaseLayout>