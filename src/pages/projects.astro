---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-5">
    <div class="text-3xl w-fit font-bold bg-gradient-to-r from-brand-magenta via-brand-purple to-brand-cyan bg-clip-text text-transparent">Projects</div>
    <div class="mt-2 mb-6 opacity-80">A selection of academic, personal, and upcoming projects across cyber security, web, mobile and game development.</div>
  </div>

  {/* TODO: Add "Practical Tools & Side Projects" section once first real-world project is built */}

  <div>
    <div class="text-2xl w-full font-bold mb-3 mt-6">Cyber Security & Forensics</div>
  </div>

  <!-- <HorizontalCard
    title="LLM-Powered Forensic Assistant"
    img="/llm-forensic.webp"
    desc="My upcoming Final Year dissertation project (2026/27). Exploring how large language models can assist digital forensic investigators with evidence triage, timeline reconstruction and report drafting. Researching prompt design, hallucination mitigation and the role of human-in-the-loop verification in forensic workflows."
    url="#"
    badge="DISSERTATION"
  /> -->
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Personal Portfolio with Security Hardening"
    img="/portfolio.webp"
    desc="The site you are reading right now. Built with Astro, Tailwind and Cloudflare Pages, with continuous deployment from GitHub. Hardened HTTP security headers from grade D to A on securityheaders.com by configuring HSTS, Content-Security-Policy, X-Frame-Options, Permissions-Policy and other defences."
    url="https://github.com/yongchivo/yongchivo-portfolio"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Yongchivo Tools"
    img="/tools-cover.webp"
    desc="A hub of free, bilingual (EN/ES) cybersecurity micro-tools at tools.yongchivo.com — eight tools now live. Client-side utilities that run entirely in the browser: Password Generator, Password Strength Analyzer, Subnet Calculator and a 'Which cyber role are you?' quiz; plus two Cloudflare Worker-backed tools — a Security Headers Checker (with strict SSRF-safe URL validation) and a Breach Checker (XposedOrNot). Built with Astro, Tailwind and Cloudflare Workers, with automatic deploys and its own A-grade security headers."
    url="https://tools.yongchivo.com"
    target="_blank"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="File Converter — Private, In-Browser"
    img="/convert-cover.webp"
    desc="A privacy-first file converter living at yongchivo.com/convert, built into this portfolio for SEO with a dedicated, keyword-targeted page per conversion. Converts images entirely in the browser — PNG ↔ JPG, PNG ↔ WebP, JPG ↔ WebP, plus HEIC → JPG/PNG for iPhone photos (Canvas API, with the libheif WASM for HEIC) — and data formats: CSV, JSON, YAML and XML, in every direction, with graceful errors on malformed input. Drag-and-drop, paste, batch and instant download; nothing is ever uploaded. Bilingual (EN/ES) on a single reusable conversion engine, structured so document and audio formats slot in next."
    url="/convert"
    target="_self"
    badge="LIVE"
  />

  <div>
    <div class="text-2xl w-full font-bold mb-3 mt-10">Mobile & Web Development</div>
  </div>

  <HorizontalCard
    title="PHV Prep UK — iOS Exam Prep App"
    img="/phv-prep-uk.webp"
    desc="My first app submitted to the App Store: exam preparation for the Wolverhampton private hire vehicle (&quot;taxi badge&quot;) licensing test. 300+ practice questions, realistic timed mock exams that mirror the real exam's pass logic, and an AI tutor for UK taxi law. Built solo with Flutter and Firebase (Auth, Firestore, Cloud Functions, europe-west2). Security-focused: server-side StoreKit 2 purchase verification, the Anthropic API key kept entirely server-side in Secret Manager (never shipped in the client), Firestore rules locking premium status to the backend, and content-safety controls on the AI feature."
    url="/phv-prep-uk"
    target="_self"
    badge="LIVE"
  />
  <!-- <HorizontalCard
  title="TeamTill — Employee Management App"
  img="/teamtill.webp"
  desc="A self-directed cross-platform mobile app (iOS and Android), built around a realistic scenario: a small retail shop that needs secure clock-in/out, schedule management and access to employment documents. Built with React Native (Expo) and Firebase. Security-focused by design: GDPR-conscious handling of employee data, EU-region storage (europe-west1), role-based Firestore and Storage rules restricting payslip access to the owning employee or an administrator, and Firebase credentials kept out of version control. Currently in development."
  url="https://github.com/yongchivo/Employee-Management-Mobile-Application-for-Retail"
  badge="PERSONAL PROJECT"
  /> -->
  
<div class="divider my-0"></div>

  <HorizontalCard
    title="MyLocation — Android App"
    img="/mylocation.webp"
    desc="A location-aware Android app backed by Google Firebase, with user authentication and real-time data storage to sync locations and events across devices. Built in Java/Kotlin as part of the Mobile Application Development module."
    url="https://github.com/yongchivo/MyLocation"
    badge="COURSEWORK"
  />

  <div>
    <div class="text-2xl w-full font-bold mb-3 mt-10">Game Development & Systems</div>
  </div>

  <HorizontalCard
    title="BlackDogHunter — 2D Game"
    img="/blackdoghunter.webp"
    desc="A complete 2D game built in Unity with C#, covering game mechanics, sprite animation, scene management and level design. Originally developed as a group academic project where the deliverable was a team report — the codebase itself was built from scratch by me."
    url="https://github.com/yongchivo/Assignment_Platform_Game"
    badge="COURSEWORK"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="University Kiosk Operating System"
    img="/kiosk-os.webp"
    desc="A locked-down kiosk OS based on Ubuntu, with auto-login, restricted user environment and start-up scripts to deliver a reliable single-purpose public terminal. Built as part of the Operating Systems module to explore Linux administration, security policies and system hardening."
    url="https://github.com/yongchivo/UW_kiosk_setup"
    badge="COURSEWORK"
  />
</BaseLayout>