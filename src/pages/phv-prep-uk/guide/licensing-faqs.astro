---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How do I renew my Wolverhampton taxi licence?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You'll need a Personal Reference Number, which the council sends by email in your renewal letter. If you haven't received it and you have less than four weeks left on your licence, contact the licensing team directly at driver.lic@wolverhampton.gov.uk.",
      },
    },
    {
      "@type": "Question",
      name: "How will I receive my Wolverhampton taxi licence?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "By email. Wolverhampton no longer issues paper licences. You won't receive a PDF copy of a renewed licence until every check on your application is fully complete.",
      },
    },
    {
      "@type": "Question",
      name: "My operator wants to see a paper licence — what do I do?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "All private hire operators have been told that licences are now issued by email. If your licence appears on the council's public register, you're allowed to work. Point your operator to the online register if they ask for paper.",
      },
    },
    {
      "@type": "Question",
      name: "Where can I drive with a Wolverhampton private hire licence?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You can accept pre-booked journeys anywhere in the country, as long as the journey is in a Wolverhampton-licensed private hire vehicle and booked through a private hire operator licensed by Wolverhampton. You cannot ply for hire or use taxi ranks — private hire is pre-booked only.",
      },
    },
    {
      "@type": "Question",
      name: "Why didn't I get a full licence term?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "For a driver licence, the council emails a letter explaining the reason — contact driver.lic@wolverhampton.gov.uk if you didn't receive it. For a vehicle licence, it's usually the age of the vehicle: a vehicle over 10 years old only receives a 6-month licence.",
      },
    },
    {
      "@type": "Question",
      name: "Can someone else drive my licensed vehicle?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, provided they are insured and hold a relevant Wolverhampton-issued driver licence.",
      },
    },
