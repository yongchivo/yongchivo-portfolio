      },
    },
    {
      "@type": "Question",
      name: "Are the practice questions specific to Solihull?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Every question in the app's Solihull mode is built from official Solihull Council source material — council policy documents, licensing handbooks and relevant UK legislation. This isn't generic PHV content.",
      },
    },
    {
      "@type": "Question",
      name: "Will mock exams just repeat the same questions?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Each mock exam pulls 48 questions — 8 from each of the six categories — from the full 300+ question bank, so you get a different paper every time. All questions are distinct: no padding or rephrased duplicates.",
      },
