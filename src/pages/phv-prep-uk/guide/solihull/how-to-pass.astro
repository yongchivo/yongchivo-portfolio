const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How many questions are on the Solihull taxi knowledge test?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "There are 48 questions on the Solihull knowledge test — 8 on each of the six subjects covered by the training course. You need 36 correct (75%) to pass.",
      },
    },
    {
      "@type": "Question",
      name: "What is the pass mark for the Solihull PHV test?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You must answer 36 of the 48 questions correctly, which is 75%. Solihull marks the paper on your overall score — there is no separate set of key questions that fails the paper on its own.",
      },
    },
    {
      "@type": "Question",
      name: "How long does the Solihull knowledge test take?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The test is allowed 60 minutes and is sat straight after the training course, which runs for approximately 4 hours with breaks.",
      },
    },
    {
      "@type": "Question",
      name: "Is the Solihull test the same as the Wolverhampton one?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Solihull sets 48 questions in 60 minutes with a 36/48 pass mark and no key questions. Wolverhampton sets 28 questions in 45 minutes, needs 21 out of 28, and adds 8 key questions where a single wrong answer fails the whole paper. Passing one does not qualify you for the other.",
      },
    },
    {
      "@type": "Question",
      name: "What happens if I fail the Solihull knowledge test?",
      acceptedAnswer: {
        "@type": "Answer",
