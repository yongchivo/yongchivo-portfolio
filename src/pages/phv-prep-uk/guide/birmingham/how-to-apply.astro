  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How do I apply for a Birmingham private hire licence?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Birmingham asks you to read its Guide to Driver Licences first, then complete the medical, DBS and driving test, and pass the knowledge test run by TTC Group. Only once you have passed do you download and complete the application form and make an appointment to bring it in with your documents.",
      },
    },
    {
      "@type": "Question",
      name: "Who carries out the Birmingham knowledge test?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "TTC Group. Birmingham City Council states that private hire knowledge tests are organised and conducted by TTC Group, who also offer an optional preparation course. You book by contacting TTC directly by email.",
      },
    },
    {
      "@type": "Question",
      name: "Do I need a driving test for a Birmingham taxi licence?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Birmingham City Council states that new applicants are required to take a driving test with the Birmingham City Council Driving School. You book it by phoning 0121 303 3311 between 9:00am and 12:00pm or 1:00pm and 3:00pm.",
      },
    },
    {
      "@type": "Question",
      name: "How do I book a taxi medical in Birmingham?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You book and pay for the medical appointment through the council's online form. For a wheelchair or dog exemption booking, you email taximedicalanddbs@birmingham.gov.uk and the team will arrange the appointment and take payment.",
      },
    },
