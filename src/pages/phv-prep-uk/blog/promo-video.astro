---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="We Made a Promo Video for PHV Prep UK"
  description="Check out our new promotional video for PHV Prep UK — the exam prep app for the Wolverhampton private hire test."
  image="/images/promo-video-announcement.png"
>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px]">
      <img
        src="/images/promo-video-announcement.png"
        alt="We made a video — PHV Prep UK"
        width="1200"
        height="630"
        class="rounded-lg"
      />

      <h1>We Made a Promo Video for PHV Prep UK</h1>

      <p>
        We've just released a short video showing PHV Prep UK in action — how
        the mock exams work, how the AI Tutor helps you understand tricky
        questions, and why the app exists in the first place.
      </p>

      <iframe
        class="mx-auto rounded-lg"
        width="315"
        height="560"
        src="https://www.youtube-nocookie.com/embed/0IMArtm9HoQ"
        title="PHV Prep UK promo video"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>

      <p>Watch it wherever you follow us:</p>

      <ul>
        <li>
          <strong>Instagram</strong> —
          <a
            href="https://www.instagram.com/yongchivo/"
            target="_blank"
            rel="noopener">@yongchivo</a
          >
        </li>
        <li>
          <strong>TikTok</strong> —
          <a
            href="https://www.tiktok.com/@yongchivo"
            target="_blank"
            rel="noopener">@yongchivo</a
          >
        </li>
        <li>
          <strong>Facebook</strong> —
          <a
            href="https://www.facebook.com/profile.php?id=61591197900185"
            target="_blank"
            rel="noopener">our Facebook page</a
          >
        </li>
        <li>
          <strong>YouTube</strong> —
          <a
            href="https://www.youtube.com/@yongchivo"
            target="_blank"
            rel="noopener">@yongchivo</a
          >
        </li>
      </ul>

      <p>
        If you're studying for the Wolverhampton PHV knowledge test, give us a
        follow — we'll be posting more tips and updates as the app grows.
      </p>
    </article>
  </main>
</BaseLayout>
