---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Join the PHV Prep UK Android Beta — Test It Now"
  description="PHV Prep UK is in closed beta on Android. Opt in and download it directly using the links below."
  image="/images/join-android-beta.png"
>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px]">
      <img
        src="/images/join-android-beta.png"
        alt="Join the Android beta — PHV Prep UK"
        width="1200"
        height="630"
        class="rounded-lg"
      />

      <h1>Join the PHV Prep UK Android Beta — Test It Now</h1>

      <p>
        PHV Prep UK is currently in closed testing on Android. If you'd like
        to try it before the public release, here's how:
      </p>

      <h2>Step 1 — Opt in to the test</h2>

      <p>
        Open this link on your Android phone (or in a browser, then follow
        the Play Store link on your phone):
        <a
          href="https://play.google.com/apps/testing/com.phvprepuk.app"
          target="_blank"
          rel="noopener"
          >play.google.com/apps/testing/com.phvprepuk.app</a
        >
      </p>

      <p>
        Tap "Become a tester" and follow the instructions. You'll need to be
        signed in with a Google account.
      </p>

      <h2>Step 2 — Download the app</h2>

      <p>
        Once you've opted in, download PHV Prep UK from the Play Store:
        <a
          href="https://play.google.com/store/apps/details?id=com.phvprepuk.app"
          target="_blank"
          rel="noopener"
          >play.google.com/store/apps/details?id=com.phvprepuk.app</a
        >
      </p>

      <p>
        It may take 10–15 minutes after opting in before the app becomes
        available to download.
      </p>

      <h2>Step 3 — Try it out</h2>

      <p>
        Use the app as you normally would — take a mock exam, try the AI
        Tutor, browse the question bank. If anything looks broken or behaves
        unexpectedly, let us know at
        <a href="mailto:support@yongchivo.com">support@yongchivo.com</a>.
      </p>
    </article>
  </main>
</BaseLayout>
