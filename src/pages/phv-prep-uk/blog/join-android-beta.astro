---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Join the PHV Prep UK Android Beta — Test It Now"
  description="PHV Prep UK is in closed beta on Android. Opt in and download it directly using the links below."
  image="/images/join-android-beta.png"
>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px]">
      <img
        src="/images/join-android-beta.png"
        alt="Join the Android beta — PHV Prep UK"
        width="1200"
        height="630"
        class="rounded-lg"
      />

      <h1>Join the PHV Prep UK Android Beta — Test It Now</h1>

      <p>
        PHV Prep UK is currently in closed testing on Android. If you'd like
        to try it before the public release, here's how:
      </p>

      <h2>How to join the beta</h2>

      <ol>
        <li>
          Join the tester group:
          <a
            href="https://groups.google.com/g/phv-prep-uk-android-testers"
            target="_blank"
            rel="noopener"
            >groups.google.com/g/phv-prep-uk-android-testers</a
          >
        </li>
        <li>
          Wait a few minutes, then open this link on your Android phone:
          <a
            href="https://play.google.com/apps/testing/com.phvprepuk.app"
            target="_blank"
            rel="noopener"
            >play.google.com/apps/testing/com.phvprepuk.app</a
          >
        </li>
        <li>
          Tap "Become a tester" on that page — this is the step that actually
          enrols you.
        </li>
        <li>
          Open the Play Store app, search for PHV Prep UK, and install.
        </li>
      </ol>

      <p>
        If anything looks broken or behaves unexpectedly, email
        <a href="mailto:support@yongchivo.com">support@yongchivo.com</a> and
        let me know.
      </p>
    </article>
  </main>
</BaseLayout>
